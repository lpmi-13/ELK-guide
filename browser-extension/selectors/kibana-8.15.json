{
  "version": 1,
  "kibana_version": "8.15.3",
  "targets": {
    "kibana.time_picker": ["[data-test-subj='superDatePickerToggleQuickMenuButton']", "button[aria-label*='date picker' i]"],
    "kibana.time_value": ["input[aria-label='Time value']", "[data-test-subj='superDatePickerRelativeDateInputNumber']"],
    "kibana.time_unit": ["select[aria-label='Time unit']", "[data-test-subj='superDatePickerRelativeDateInputUnitSelector']"],
    "kibana.time_apply": ["button.euiQuickSelect__applyButton", "[data-test-subj='superDatePickerApplyTimeButton']"],
    "kibana.time_from": ["[data-test-subj='superDatePickerAbsoluteDateInput'] input", "input[aria-label*='start date' i]"],
    "kibana.query_bar": ["textarea[data-test-subj='queryInput']", "input[data-test-subj='queryInput']", "[data-test-subj='queryInput'] textarea", "[data-test-subj='queryInput'] input", "textarea[aria-label*='query' i]"],
    "kibana.query_submit": ["[data-test-subj='querySubmitButton']", "button[aria-label*='submit query' i]"],
    "kibana.add_filter": ["[data-test-subj='addFilter']", "button[aria-label*='add filter' i]"],
    "kibana.first_result": ["[data-test-subj='docTableExpandToggleColumn'] button", "[data-test-subj='docTableExpandToggleColumn']"],
    "kibana.first_trace_value": ["[data-gridcell-column-id='trace.id'][data-gridcell-row-index='0'] [data-datagrid-cellcontent='true']"],
    "kibana.trace_field": ["[data-test-subj='tableDocViewRow-trace.id-value']", "[data-test-subj*='trace.id']"]
  }
}
