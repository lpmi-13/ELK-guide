{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elk-guide.local/schemas/command.schema.json",
  "title": "Semantic Kibana command v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "command_id", "run_id", "session_id", "sequence", "type", "target", "mode"],
  "properties": {
    "protocol_version": {"const": 2},
    "command_id": {"type": "string"}, "run_id": {"type": "string"}, "session_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"enum": [
      "orient", "navigate_to_app", "open_saved_object", "set_time_range", "shift_time_range", "refresh_data", "set_auto_refresh",
      "select_data_view", "enter_kql", "enter_query", "switch_query_language", "enter_esql", "add_filter", "edit_filter", "remove_filter", "disable_filter",
      "add_column", "remove_column", "sort_column", "expand_document", "inspect_field", "open_field_statistics", "open_surrounding_documents",
      "set_dashboard_control", "interact_with_panel_value", "open_panel_drilldown", "inspect_panel", "view_panel_underlying_data",
      "select_apm_service", "select_apm_environment", "open_transaction_group", "select_trace_sample", "open_trace", "select_span", "open_error_details",
      "navigate_to_correlated_logs", "select_inventory_type", "select_infrastructure_entity",
      "filter_infrastructure_entities", "group_infrastructure_entities", "select_metric", "compare_metric_period", "navigate_from_metrics_to_logs",
      "open_alert", "filter_alerts", "inspect_alert_reason", "inspect_alert_history", "navigate_from_alert_to_source", "request_answer",
      "request_diagnosis", "show_debrief", "pause", "resume"
    ]},
    "target": {"type": "string"}, "value": {}, "expected_page": {"type": "string"},
    "mode": {"enum": ["demonstration", "guided", "challenge"]}, "narration": {"type": "string"},
    "reasoning": {"type": "string"}, "evidence": {"type": "string"}, "concept": {"type": "string"},
    "answer_schema": {"type": "object"}, "message_type": {"type": "string"}, "step_id": {"type": "string"},
    "step_index": {"type": "integer"}, "step_count": {"type": "integer"}
  }
}
