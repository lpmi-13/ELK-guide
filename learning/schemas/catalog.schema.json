{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://elk-guide.local/schemas/catalog.schema.json",
  "title": "Scenario catalog v2", "type": "object", "additionalProperties": false, "required": ["schema_version", "kibana_version", "scenarios"],
