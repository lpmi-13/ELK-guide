{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elk-guide.local/schemas/playbook.schema.json",
  "title": "Goal graph playbook v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "oneOf": [
    {"required": ["extends", "variables"]},
    {"required": ["id", "version", "starting_view", "demonstration_summary", "goals"]}
  ],
  "properties": {
    "schema_version": {"const": 2},
    "extends": {"type": "string", "pattern": "^[^/]+\\.json$"},
    "variables": {"type": "object"},
    "overrides": {"type": "object"},
    "goal_overrides": {
      "type": "object",
      "description": "Per-goal patches merged into the extended template's goals by id, e.g. to vary a demo's reference_action while keeping the shared goal graph, hints, and accepted routes.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "narration": {"type": "string"},
          "demonstration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "narration": {"type": "string"},
              "reasoning": {"type": "string"},
              "evidence": {"type": "string"},
              "concept": {"type": "string"}
            }
          },
          "reference_action": {
            "type": "object",
            "required": ["command", "target"],
            "properties": {"command": {"type": "string"}, "target": {"type": "string"}, "arguments": {}}
          },
          "hints": {"type": "array", "minItems": 3, "items": {"type": "string"}}
        }
      }
    },
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "starting_view": {
      "type": "object",
      "required": ["app"],
      "properties": {"app": {"type": "string"}, "saved_object": {"type": "string"}}
    },
    "demonstration_summary": {
      "type": "object",
      "required": ["title", "summary", "checks", "evidence", "conclusion", "answer"],
      "properties": {
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "detail"],
            "properties": {"title": {"type": "string"}, "detail": {"type": "string"}}
          }
        },
        "evidence": {"type": "string"},
        "conclusion": {"type": "string"},
        "answer": {"type": "object"},
        "diagnosis": {"type": "object"}
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "concept", "requires", "accepts", "reference_action", "hints"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "concept": {"type": "string"},
          "narration": {"type": "string"},
          "reasoning": {"type": "string"},
          "evidence": {"type": "string"},
          "demonstration": {
            "type": "object",
            "description": "Optional demonstration-only teaching copy. It may use scenario, truth, run, template-variable, and run-parameter tokens without exposing answers in guided mode.",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "narration": {"type": "string"},
              "reasoning": {"type": "string"},
              "evidence": {"type": "string"},
              "concept": {"type": "string"}
            }
          },
          "requires": {"type": "array", "items": {"type": "string"}},
          "accepts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action", "validators"],
              "properties": {
                "action": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
                "validators": {"type": "array", "items": {"type": "object", "required": ["kind"]}}
              }
            }
          },
          "reference_action": {
            "type": "object",
            "required": ["command", "target"],
            "properties": {"command": {"type": "string"}, "target": {"type": "string"}, "arguments": {}}
          },
          "hints": {"type": "array", "minItems": 3, "items": {"type": "string"}},
          "scored": {"type": "boolean"}
        }
      }
    }
  }
}
