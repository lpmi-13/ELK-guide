{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elk-guide.local/schemas/rubric.schema.json",
  "title": "Investigation scoring rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "goals", "weights", "reference_action_cost"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "goals": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "weights": {
      "type": "object",
      "required": ["diagnosis", "evidence", "coverage", "relevance", "efficiency"],
      "properties": {
        "diagnosis": {"type": "number"},
        "evidence": {"type": "number"},
        "coverage": {"type": "number"},
        "relevance": {"type": "number"},
        "efficiency": {"type": "number"}
      }
    },
    "reference_action_cost": {"type": "number", "exclusiveMinimum": 0},
    "action_costs": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
  }
}
