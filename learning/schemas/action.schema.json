{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elk-guide.local/schemas/action.schema.json",
  "title": "Normalized Kibana observation v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol_version", "run_id", "session_id", "sequence", "type", "actor", "observed_at"],
  "properties": {
    "protocol_version": {"const": 2},
    "run_id": {"type": "string"},
    "session_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {
      "enum": [
        "app_navigated", "saved_object_opened", "time_range_changed", "auto_refresh_changed", "data_refreshed",
        "data_view_selected", "query_language_changed", "query_submitted", "esql_submitted", "query_rejected",
        "filter_added", "filter_changed", "filter_removed", "filter_disabled", "column_added", "column_removed",
        "sort_changed", "document_expanded", "field_inspected", "field_statistics_opened", "surrounding_documents_opened",
        "dashboard_control_changed", "panel_value_selected", "panel_drilldown_opened", "panel_inspected", "panel_underlying_data_opened",
        "apm_service_selected", "apm_environment_selected", "transaction_group_opened", "trace_sample_selected", "trace_opened",
        "span_selected", "error_details_opened", "correlated_logs_opened",
        "inventory_type_selected", "infrastructure_entity_selected", "infrastructure_entities_filtered", "infrastructure_entities_grouped",
        "metric_selected", "metric_period_compared", "metrics_logs_opened", "alert_opened", "alerts_filtered",
        "alert_reason_inspected", "alert_history_inspected", "alert_source_opened",
        "hint_requested", "step_demonstrated", "answer_submitted", "command_acknowledged"
      ]
    },
    "actor": {"enum": ["learner", "tutorial"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "state_before": {"type": "object"},
    "state_after": {"type": "object"},
    "details": {"type": "object"}
  }
}
