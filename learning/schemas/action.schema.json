{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elk-guide.local/schemas/action.schema.json",
  "title": "Normalized learner action",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol_version", "run_id", "session_id", "sequence", "type", "actor", "observed_at"],
  "properties": {
    "protocol_version": {"const": 1},
    "run_id": {"type": "string"},
    "session_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"enum": ["navigate_to_view", "time_range_changed", "query_submitted", "query_rejected", "filter_added", "filter_changed", "filter_removed", "sort_changed", "field_inspected", "document_expanded", "trace_opened", "visualization_drilled_down", "hint_requested", "step_demonstrated", "diagnosis_submitted", "command_acknowledged"]},
    "actor": {"enum": ["learner", "tutorial"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "state_before": {"type": "object"},
    "state_after": {"type": "object"},
    "details": {"type": "object"}
  }
}
