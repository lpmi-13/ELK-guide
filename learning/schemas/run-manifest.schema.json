{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://elk-guide.local/schemas/run-manifest.schema.json",
  "title": "Materialized scenario run v2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "space_id", "template_id", "template_version", "template_hash", "seed", "generator_version", "created_at", "scenario", "expected", "playbook", "rubric"],
  "properties": {
    "schema_version": {"const": 2}, "run_id": {"type": "string", "pattern": "^run-[a-f0-9]+$"}, "space_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "template_id": {"type": "string"}, "template_version": {"type": "integer", "minimum": 1}, "template_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed": {"type": "integer", "minimum": 0}, "scenario_key": {"type": "string", "minLength": 10, "maxLength": 40}, "generator_version": {"const": 2},
    "created_at": {"type": "string", "format": "date-time"}, "scenario": {"type": "object"}, "expected": {"type": "object"}, "playbook": {"type": "string"}, "rubric": {"type": "string"}
  }
}
