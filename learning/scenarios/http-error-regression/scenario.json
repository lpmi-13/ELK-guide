  "provisioning": {
    "strategies": [
      "seeded-events",
      "saved-objects"
    ],
    "seeded_events": {
      "signal_count": 32,
      "noise_count": 90,
      "signal": {
        "service": {
          "name": "${param.incident.service}",
          "version": "${param.incident.version}"
        },
        "event": {
          "outcome": "failure"
        },
        "http": {
          "response": {
            "status_code": "${param.incident.status}"
          }
        },
        "url": {
          "path": "${param.incident.route_path}"
        },
        "error": {
          "type": "${param.incident.error_type}"
        },
        "message": "${param.incident.message}"
      },
      "companions": [
        {
          "count": 3,
          "event": {
            "service": {
              "name": "${param.incident.service}",
              "version": "${param.incident.version}"
            },
            "event": {
              "outcome": "failure"
            },
            "http": {
              "response": {
                "status_code": "${param.incident.status}"
              }
            },
            "url": {
              "path": "${param.incident.route_path}"
            },
            "error": {
              "type": "${param.incident.error_type}"
            },
            "message": "representative ${param.incident.error_type} request failed"
          }
        },
        {
          "count": 75,
          "offset_seconds": 14,
          "interval_seconds": 7,
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.decoy_service}"
            },
            "event": {
              "outcome": "success"
            },
            "http": {
              "request": {
                "method": "GET"
              },
              "response": {
                "status_code": 200
              }
            },
            "url": {
              "path": "${param.incident.decoy_path}"
            },
            "message": "request completed"
          }
        }
      ]
    },
    "readiness_validators": [
      {
        "id": "seeded-signal",
        "kind": "es_count",
        "minimum": 20,
        "query": {
          "term": {
            "message.keyword": "${param.incident.message}"
          }
        }
      }
    ]
  },
  "starting_view": {
    "app": "discover",
    "saved_object": "incident-investigation",
    "path": "/app/discover#/view/incident-investigation"
  },
  "truth": {
    "answers": {
      "finding": "${param.incident.finding}",
      "scope": "${param.incident.status_family}",
      "conclusion": "${param.incident.error_type} errors on ${param.incident.finding} started with the new release."
    },
    "accept": {
      "scope": [
        "${param.incident.status}",
        "5xx"
      ],
      "error_type": [
        "${param.incident.error_type}"
      ]
    },
    "assertions": [
      {
        "id": "signal",
        "kind": "es_count",
        "minimum": 20,
        "query": {
          "term": {
            "message.keyword": "${param.incident.message}"
          }
        }
      },
      {
        "id": "corroboration",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "term": {
            "message.keyword": "representative ${param.incident.error_type} request failed"
          }
        }
      },
      {
        "id": "healthy_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "range": {
            "http.response.status_code": {
              "lt": 500
            }
          }
        }
      },
      {
        "id": "no_errors_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "range": {
            "http.response.status_code": {
              "gte": 500
            }
          }
        }
      }
    ]
  },
  "answer_schema": {
    "type": "diagnosis",
    "fields": [
      {
        "id": "finding",
        "label": "Affected endpoint or service",
        "kind": "string",
        "weight": 2
      },
      {
        "id": "scope",
        "label": "Status code",
        "kind": "string",
        "weight": 1
      },
      {
        "id": "conclusion",
        "label": "Conclusion",
        "kind": "statement",
        "mentions": [
          "finding",
          "error_type"
        ],
        "weight": 1
      },
      {
        "id": "evidence",
        "label": "Example event",
        "kind": "text",
        "scored": false
      }
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {
    "delete_space": true,
    "delete_run_data": true,
