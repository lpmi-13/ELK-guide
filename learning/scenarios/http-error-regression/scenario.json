        "query": {
          "term": {
            "message.keyword": "${param.incident.message}"
          }
        }
      },
      {
        "id": "corroboration",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "bool": {
            "should": [
              {
                "term": {
                  "message.keyword": "${param.incident.message}"
                }
              },
              {
                "term": {
                  "message.keyword": "representative ${param.incident.error_type} request failed"
                }
              }
            ],
            "minimum_should_match": 1
          }
        }
      },
      {
        "id": "healthy_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "range": {
            "http.response.status_code": {
              "lt": 500
            }
          }
        }
      },
      {
        "id": "no_errors_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "range": {
            "http.response.status_code": {
              "gte": 500
            }
          }
        }
      }
    ]
