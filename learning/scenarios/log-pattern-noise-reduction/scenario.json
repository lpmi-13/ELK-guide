{
  "schema_version": 2,
  "id": "log-pattern-noise-reduction",
  "version": 2,
  "title": "Reduce log-pattern noise",
  "type": "investigation",
  "classification": "core",
  "difficulty": 2,
  "estimated_minutes": 15,
  "brief": "A service emits thousands of repetitive warnings. Find the message pattern that actually correlates with failures.",
  "skills": ["message-filtering", "include-exclude", "patterns"],
  "required_capabilities": ["discover", "spaces", "saved_objects"],
  "parameters": {
    "incident": {
      "choose": [
        {"service": "payments", "error_message": "payment authorization exhausted", "noise_a": "payment provider heartbeat delayed", "noise_b": "payment token cache nearing expiry", "exclude_fragment": "heartbeat delayed", "status": 502},
        {"service": "catalog", "error_message": "catalog index rebuild failed", "noise_a": "catalog cache warm skipped", "noise_b": "catalog sync retry scheduled", "exclude_fragment": "cache warm skipped", "status": 503},
        {"service": "orders", "error_message": "order settlement rejected", "noise_a": "order shipping estimate stale", "noise_b": "order inventory sync delayed", "exclude_fragment": "shipping estimate stale", "status": 500},
        {"service": "auth", "error_message": "session key validation failed", "noise_a": "auth token refresh throttled", "noise_b": "auth cache eviction noisy", "exclude_fragment": "token refresh throttled", "status": 401}
      ]
    },
    "window": {"choose": ["20m", "30m", "45m", "1h"]}
  },
  "provisioning": {
    "strategies": ["seeded-events", "saved-objects"],
    "seeded_events": {
      "signal_count": 24,
      "noise_count": 180,
      "signal": {
        "labels": {"signal": "decisive"},
        "service": {"name": "${param.incident.service}"},
        "event": {"outcome": "failure"},
        "log": {"level": "ERROR"},
        "message": "${param.incident.error_message}"
      },
      "distractors": [
        {"log": {"level": "WARN"}, "message": "${param.incident.noise_a}"},
        {"log": {"level": "WARN"}, "message": "${param.incident.noise_b}"}
      ],
      "companions": [
        {
          "count": 3,
          "event": {
            "labels": {"corroboration": true},
            "service": {"name": "${param.incident.service}"},
            "event": {"outcome": "failure"},
            "http": {"response": {"status_code": "${param.incident.status}"}},
            "message": "request failed after ${param.incident.error_message}"
          }
        }
      ]
    },
    "readiness_validators": [
      {"id": "seeded-signal", "kind": "es_count", "minimum": 20, "query": {"term": {"labels.signal.keyword": "decisive"}}}
    ]
  },
  "starting_view": {"app": "discover", "saved_object": "incident-investigation", "path": "/app/discover#/view/incident-investigation"},
  "truth": {
    "answers": {
      "finding": "${param.incident.error_message}",
      "scope": "${param.incident.service}",
      "conclusion": "The '${param.incident.error_message}' pattern correlates with failures; the repetitive ${param.incident.service} warnings are background noise."
    },
    "assertions": [
      {"id": "signal", "kind": "es_count", "minimum": 20, "query": {"term": {"labels.signal.keyword": "decisive"}}},
      {"id": "corroboration", "kind": "es_count", "minimum": 1, "query": {"term": {"labels.corroboration": true}}}
    ]
  },
  "answer_schema": {
    "type": "diagnosis",
    "fields": [
      {"id": "finding", "label": "Failure-associated pattern", "kind": "string", "weight": 2},
      {"id": "scope", "label": "Service", "kind": "string", "weight": 1},
      {"id": "conclusion", "label": "Noise comparison", "kind": "string", "weight": 1},
      {"id": "evidence_refs", "label": "Evidence references", "kind": "string", "scored": false},
      {"id": "evidence", "label": "Evidence", "kind": "text", "scored": false}
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {"delete_space": true, "delete_run_data": true, "managed_resources": []}
}
