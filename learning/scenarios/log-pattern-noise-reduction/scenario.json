{
  "schema_version": 2,
  "id": "log-pattern-noise-reduction",
  "version": 4,
  "title": "Find the log pattern that matters",
  "type": "investigation",
  "classification": "core",
  "difficulty": 2,
  "estimated_minutes": 15,
  "brief": "A service logs thousands of repeated warnings. Find the one message pattern that is linked to the failed requests.",
  "skills": ["message-filtering", "include-exclude", "patterns"],
  "required_capabilities": ["discover", "spaces", "saved_objects"],
  "parameters": {
    "incident": {
      "choose": [
        {"service": "payments", "error_message": "payment authorization exhausted", "noise_a": "payment provider heartbeat delayed", "noise_b": "payment token cache nearing expiry", "exclude_fragment": "heartbeat delayed", "status": 502},
        {"service": "payments", "error_message": "settlement ledger lock lost", "noise_a": "payment fraud score cache cold", "noise_b": "payment webhook retry queued", "exclude_fragment": "score cache cold", "status": 503},
        {"service": "catalog", "error_message": "catalog index rebuild failed", "noise_a": "catalog cache warm skipped", "noise_b": "catalog sync retry scheduled", "exclude_fragment": "cache warm skipped", "status": 503},
        {"service": "catalog", "error_message": "price feed checksum mismatch", "noise_a": "catalog image resize deferred", "noise_b": "catalog search shard slow", "exclude_fragment": "resize deferred", "status": 500},
        {"service": "orders", "error_message": "order settlement rejected", "noise_a": "order shipping estimate stale", "noise_b": "order inventory sync delayed", "exclude_fragment": "shipping estimate stale", "status": 500},
        {"service": "orders", "error_message": "order id sequence exhausted", "noise_a": "order export batch slow", "noise_b": "order audit log rotated", "exclude_fragment": "export batch slow", "status": 502},
        {"service": "auth", "error_message": "session key validation failed", "noise_a": "auth token refresh throttled", "noise_b": "auth cache eviction noisy", "exclude_fragment": "token refresh throttled", "status": 401},
        {"service": "checkout", "error_message": "cart total recalculation failed", "noise_a": "checkout promo cache refreshed late", "noise_b": "checkout session store compacting", "exclude_fragment": "promo cache refreshed late", "status": 500}
      ]
    }
  },
  "provisioning": {
    "strategies": ["seeded-events", "saved-objects"],
    "seeded_events": {
      "signal_count": 24,
      "noise_count": 180,
      "signal": {
        "service": {"name": "${param.incident.service}"},
        "event": {"outcome": "failure"},
        "log": {"level": "ERROR"},
        "message": "${param.incident.error_message}"
      },
      "distractors": [
        {"log": {"level": "WARN"}, "message": "${param.incident.noise_a}"},
        {"log": {"level": "WARN"}, "message": "${param.incident.noise_b}"}
      ],
      "companions": [
        {
          "count": 3,
          "event": {
            "service": {"name": "${param.incident.service}"},
            "event": {"outcome": "failure"},
            "http": {"response": {"status_code": "${param.incident.status}"}},
            "message": "request failed after ${param.incident.error_message}"
          }
        },
        {
          "count": 60,
          "offset_seconds": 15,
          "interval_seconds": 9,
          "trace": "own",
          "event": {
            "service": {"name": "${param.incident.service}"},
            "event": {"outcome": "success"},
            "http": {"response": {"status_code": 200}},
            "log": {"level": "WARN"},
            "message": "${param.incident.noise_a}"
          }
        },
        {
          "count": 60,
          "offset_seconds": 22,
          "interval_seconds": 15,
          "trace": "own",
          "event": {
            "service": {"name": "${param.incident.service}"},
            "event": {"outcome": "failure"},
            "http": {"response": {"status_code": "${param.incident.status}"}},
            "log": {"level": "WARN"},
            "message": "${param.incident.noise_a}"
          }
        }
      ]
    },
    "readiness_validators": [
      {"id": "seeded-signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "${param.incident.error_message}"}}}
    ]
  },
  "starting_view": {"app": "discover", "saved_object": "incident-investigation", "path": "/app/discover#/view/incident-investigation?_a=(columns:!('@timestamp',service.name,event.outcome,log.level,message))"},
  "truth": {
    "answers": {
      "finding": "${param.incident.error_message}",
      "scope": "${param.incident.service}",
      "conclusion": "The '${param.incident.error_message}' pattern is linked to the failures. The repeated ${param.incident.service} warning shows up whether requests fail or not."
    },
    "assertions": [
      {"id": "signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "${param.incident.error_message}"}}},
      {"id": "corroboration", "kind": "es_count", "minimum": 1, "query": {"bool": {"should": [{"term": {"message.keyword": "${param.incident.error_message}"}}, {"term": {"message.keyword": "request failed after ${param.incident.error_message}"}}], "minimum_should_match": 1}}},
      {"id": "warning_everywhere", "kind": "es_count", "minimum": 1, "query": {"bool": {"filter": [{"term": {"message.keyword": "${param.incident.noise_a}"}}], "must_not": [{"term": {"event.outcome.keyword": "failure"}}]}}}
    ]
  },
  "answer_schema": {
    "type": "diagnosis",
    "fields": [
      {"id": "finding", "label": "Pattern linked to failures", "kind": "string", "weight": 2},
      {"id": "scope", "label": "Service", "kind": "string", "weight": 1},
      {"id": "conclusion", "label": "Conclusion", "kind": "statement", "mentions": ["finding"], "weight": 1},
      {"id": "evidence", "label": "Evidence", "kind": "text", "scored": false}
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {"delete_space": true, "delete_run_data": true, "managed_resources": []}
}
