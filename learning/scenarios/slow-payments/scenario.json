{"schema_version":2,"id":"slow-payments","version":4,"title":"Checkout requests are suddenly slow","type":"investigation","classification":"legacy","difficulty":1,"estimated_minutes":12,"brief":"Users report that checkout became slow in the last few minutes. Find the bottleneck, and back it up with correlated evidence: the same request seen in each service.","skills":["discover","kql","trace-correlation"],"required_capabilities":["discover","spaces","saved_objects"],"parameters":{"fault":{"choose":[{"service":"payments","chain":"api-gateway, orders and payments"},{"service":"catalog","chain":"api-gateway, orders and catalog"},{"service":"auth","chain":"api-gateway and auth"}]},"delay":{"choose":[{"ms":3500,"seconds":"3.5","minimum_ns":3000000000},{"ms":4000,"seconds":"4","minimum_ns":3500000000},{"ms":4500,"seconds":"4.5","minimum_ns":4000000000}]}},"provisioning":{"strategies":["live-traffic","saved-objects"],"live_traffic":{"fault":{"service":"${param.fault.service}","type":"latency","delay_ms":"${param.delay.ms}","probability":0.85,"paths":["/checkout"]},"traffic":{"entrypoint":"api-gateway","path":"/checkout","requests_per_second":3}},"readiness_validators":[{"id":"affected-traces","kind":"es_cardinality","index":"microservices-*","field":"trace.id.keyword","minimum":10,"timeout_seconds":120,"query":{"bool":{"filter":[{"match_phrase":{"scenario.id":"${run_id}"}},{"match_phrase":{"service.name":"${param.fault.service}"}},{"match_phrase":{"event.type":"transaction"}},{"range":{"event.duration":{"gte":"${param.delay.minimum_ns}"}}}]}}}]},"starting_view":{"app":"discover","saved_object":"incident-investigation","path":"/app/discover#/view/incident-investigation"},"truth":{"answers":{"finding":"${param.fault.service}","scope":"/checkout","conclusion":"The ${param.fault.service} service's latency is the bottleneck, and it slows down the whole checkout request."},"accept":{"scope":["/checkout","checkout"],"latency":["latency","slow","slowness","delay","delayed","bottle