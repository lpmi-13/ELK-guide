{
  "schema_version": 2,
  "id": "deployment-version-regression",
  "version": 5,
  "title": "Failures after a rolling deployment",
  "type": "investigation",
  "classification": "core",
  "difficulty": 2,
  "estimated_minutes": 20,
  "brief": "After a rolling deployment, some of a service's requests fail while others succeed. Find what the failing requests have in common, and when the first failure happened.",
  "skills": [
    "top-values",
    "field-statistics",
    "include-exclude",
    "sorting"
  ],
  "required_capabilities": [
    "discover",
    "spaces",
    "saved_objects"
  ],
  "parameters": {
    "incident": {
      "choose": [
        {
          "service": "orders",
          "bad_version": "2.4.1",
          "good_version": "2.4.0",
          "status": 500,
          "legacy_version": "2.3.7",
          "route_a": "/api/orders",
          "route_b": "/api/orders/search",
          "route_c": "/api/orders/history"
        },
        {
          "service": "payments",
          "bad_version": "3.2.0",
          "good_version": "3.1.4",
          "status": 502,
          "legacy_version": "3.0.9",
          "route_a": "/api/payments/authorize",
          "route_b": "/api/payments/capture",
          "route_c": "/api/payments/refund"
        },
        {
          "service": "catalog",
          "bad_version": "1.9.0",
          "good_version": "1.8.5",
          "status": 503,
          "legacy_version": "1.7.2",
          "route_a": "/api/catalog/search",
          "route_b": "/api/catalog/items",
          "route_c": "/api/catalog/categories"
        },
        {
          "service": "auth",
          "bad_version": "4.1.0",
          "good_version": "4.0.7",
          "status": 500,
          "legacy_version": "3.9.4",
          "route_a": "/api/auth/token",
          "route_b": "/api/auth/refresh",
          "route_c": "/api/auth/session"
        }
      ]
    },
    "timing": {
      "choose": [
        {
          "rollout": 14,
          "first": 12.5,
          "noticed": 8,
          "first_seconds": 750,
          "signal_oldest_seconds": 730,
          "before_rollout_seconds": 870
        },
        {
          "rollout": 16,
          "first": 14.5,
          "noticed": 9,
          "first_seconds": 870,
          "signal_oldest_seconds": 850,
          "before_rollout_seconds": 990
        },
        {
          "rollout": 18,
          "first": 16,
          "noticed": 10,
          "first_seconds": 960,
          "signal_oldest_seconds": 940,
          "before_rollout_seconds": 1110
        }
      ]
    }
  },
  "provisioning": {
    "strategies": [
      "seeded-events",
      "saved-objects"
    ],
    "seeded_events": {
      "signal_count": 35,
      "noise_count": 100,
      "noise_exclude_services": [
        "${param.incident.service}"
      ],
      "signal_window_seconds": [
        10,
        "${param.timing.signal_oldest_seconds}"
      ],
      "signal": {
        "service": {
          "name": "${param.incident.service}",
          "version": "${param.incident.bad_version}"
        },
        "event": {
          "outcome": "failure"
        },
        "http": {
          "response": {
            "status_code": "${param.incident.status}"
          }
        },
        "transaction": {
          "result": "HTTP 5xx"
        },
        "message": "${param.incident.service} request failed with HTTP ${param.incident.status}"
      },
      "distractors": [
        {
          "service": {
            "name": "${param.incident.service}",
            "version": "${param.incident.good_version}"
          },
          "event": {
            "outcome": "success"
          },
          "http": {
            "response": {
              "status_code": 200
            },
            "request": {
              "method": "GET"
            }
          },
          "url": {
            "path": "${param.incident.route_b}"
          }
        }
      ],
      "companions": [
        {
          "count": 38,
          "offset_seconds": 12,
          "interval_seconds": 26,
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}",
              "version": "${param.incident.good_version}"
            },
            "event": {
              "outcome": "success"
            },
            "http": {
              "response": {
                "status_code": 200
              }
            },
            "message": "request completed"
          },
          "cycle": [
            {
              "url": {
                "path": "${param.incident.route_a}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_b}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_c}"
              }
            }
          ]
        },
        {
          "count": 5,
          "offset_seconds": "${param.timing.before_rollout_seconds}",
          "interval_seconds": 45,
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}",
              "version": "${param.incident.good_version}"
            },
            "event": {
              "outcome": "success"
            },
            "http": {
              "response": {
                "status_code": 200
              }
            },
            "message": "request completed"
          },
          "cycle": [
            {
              "url": {
                "path": "${param.incident.route_a}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_b}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_c}"
              }
            }
          ]
        },
        {
          "count": 1,
          "offset_seconds": "${param.timing.first_seconds}",
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}",
              "version": "${param.incident.bad_version}"
            },
            "event": {
              "outcome": "failure"
            },
            "http": {
              "response": {
                "status_code": "${param.incident.status}"
              }
            },
            "transaction": {
              "result": "HTTP 5xx"
            },
            "message": "${param.incident.service} request failed with HTTP ${param.incident.status}"
          },
          "cycle": [
            {
              "url": {
                "path": "${param.incident.route_a}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_b}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_c}"
              }
            }
          ]
        },
        {
          "count": 24,
          "offset_seconds": 20,
          "interval_seconds": 40,
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}",
              "version": "${param.incident.legacy_version}"
            },
            "event": {
              "outcome": "success"
            },
            "http": {
              "response": {
                "status_code": 200
              }
            },
            "message": "request completed"
          },
          "cycle": [
            {
              "url": {
                "path": "${param.incident.route_a}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_b}"
              }
            },
            {
              "url": {
                "path": "${param.incident.route_c}"
              }
            }
          ]
        }
      ],
      "signal_cycle": [
        {
          "url": {
            "path": "${param.incident.route_a}"
          }
        },
        {
          "url": {
            "path": "${param.incident.route_b}"
          }
        },
        {
          "url": {
            "path": "${param.incident.route_c}"
          }
        }
      ]
    },
    "readiness_validators": [
      {
        "id": "seeded-signal",
        "kind": "es_count",
        "minimum": 20,
        "query": {
          "term": {
            "message.keyword": "${param.incident.service} request failed with HTTP ${param.incident.status}"
          }
        }
      }
    ]
  },
  "starting_view": {
    "app": "discover",
    "saved_object": "incident-investigation",
    "path": "/app/discover#/view/incident-investigation?_a=(columns:!('@timestamp',service.name,host.name,url.path,service.version,http.response.status_code))"
  },
  "truth": {
    "answers": {
      "finding": "${param.incident.bad_version}",
      "scope": "${param.incident.service}",
      "conclusion": "In ${param.incident.service}, every failed request ran version ${param.incident.bad_version} and no successful one did, so the new version is causing the failures.",
      "first_seen": "${incident.first_clock}"
    },
    "accept": {
      "finding": [
        "v${param.incident.bad_version}"
      ]
    },
    "assertions": [
      {
        "id": "signal",
        "kind": "es_count",
        "minimum": 20,
        "query": {
          "term": {
            "message.keyword": "${param.incident.service} request failed with HTTP ${param.incident.status}"
          }
        }
      },
      {
        "id": "corroboration",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "bool": {
            "filter": [
              {
                "term": {
                  "service.name.keyword": "${param.incident.service}"
                }
              },
              {
                "term": {
                  "service.version.keyword": "${param.incident.good_version}"
                }
              },
              {
                "term": {
                  "http.response.status_code": 200
                }
              }
            ]
          }
        }
      },
      {
        "id": "first_appearance",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "bool": {
            "filter": [
              {
                "term": {
                  "service.version.keyword": "${param.incident.bad_version}"
                }
              },
              {
                "range": {
                  "@timestamp": {
                    "lte": "${incident.first_at}||+5s"
                  }
                }
              }
            ]
          }
        }
      },
      {
        "id": "healthy_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "term": {
            "event.outcome.keyword": "success"
          }
        }
      },
      {
        "id": "failures_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "term": {
            "event.outcome.keyword": "failure"
          }
        }
      }
    ]
  },
  "answer_schema": {
    "type": "diagnosis",
    "fields": [
      {
        "id": "finding",
        "label": "What the failed requests share",
        "kind": "string",
        "weight": 2,
        "placeholder": "A field and its value"
      },
      {
        "id": "scope",
        "label": "Service",
        "kind": "string",
        "weight": 1
      },
      {
        "id": "first_seen",
        "label": "First failure",
        "kind": "clock",
        "at": "first",
        "weight": 1,
        "placeholder": "The time Discover shows for it (HH:MM)"
      },
      {
        "id": "conclusion",
        "label": "Conclusion",
        "kind": "statement",
        "mentions": [
          "finding",
          "scope"
        ],
        "weight": 1
      },
      {
        "id": "evidence",
        "label": "Evidence",
        "kind": "text",
        "scored": false
      }
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {
    "delete_space": true,
    "delete_run_data": true,
    "managed_resources": []
  }
}
