{
  "schema_version": 2,
  "id": "deployment-version-regression",
  "version": 7,
  "title": "Failures after a change",
  "type": "investigation",
  "classification": "core",
  "difficulty": 2,
  "estimated_minutes": 20,
  "brief": "A change is rolling out to one service, and some of its requests now fail while others succeed. Find what the failing requests have in common, and when the first failure happened.",
  "skills": [
    "top-values",
    "field-statistics",
    "include-exclude",
    "sorting"
  ],
  "required_capabilities": [
    "discover",
    "spaces",
    "saved_objects"
  ],
  "parameters": {
    "incident": {
      "merge": [
        {
          "choose": [
            {
              "service": "orders",
              "route_a": "/api/orders",
              "route_b": "/api/orders/search",
              "route_c": "/api/orders/history"
            },
            {
              "service": "payments",
              "route_a": "/api/payments/authorize",
              "route_b": "/api/payments/capture",
              "route_c": "/api/payments/refund"
            },
            {
              "service": "catalog",
              "route_a": "/api/catalog/search",
              "route_b": "/api/catalog/items",
              "route_c": "/api/catalog/categories"
            },
            {
              "service": "auth",
              "route_a": "/api/auth/token",
              "route_b": "/api/auth/refresh",
              "route_c": "/api/auth/session"
            },
            {
              "service": "checkout",
              "route_a": "/checkout",
              "route_b": "/checkout/cart",
              "route_c": "/checkout/confirm"
            }
          ]
        },
        {
          "release": {
            "major": [
              1,
              6
            ],
            "minor": [
              2,
              9
            ],
            "patch": [
              1,
              9
            ],
            "as": {
              "new": "new_version",
              "current": "current_version",
              "legacy": "legacy_version"
            }
          }
        },
        {
          "choose": [
            {
              "status": 500
            },
            {
              "status": 502
            },
            {
              "status": 503
            },
            {
              "status": 504
            }
          ]
        }
      ]
    },
    "nodes": {
      "sample": [
        "03",
        "07",
        "11",
        "14",
        "18",
        "22",
        "25",
        "29",
        "31",
        "36",
        "42",
        "47",
        "53",
        "58",
        "64"
      ],
      "count": 5
    },
    "timing": {
      "choose": [
        {
          "rollout": 14,
          "first": 12.5,
          "noticed": 8,
          "first_seconds": 750,
          "signal_oldest_seconds": 730,
          "before_rollout_seconds": 870
        },
        {
          "rollout": 16,
          "first": 14.5,
          "noticed": 9,
          "first_seconds": 870,
          "signal_oldest_seconds": 850,
          "before_rollout_seconds": 990
        },
        {
          "rollout": 18,
          "first": 16,
          "noticed": 10,
          "first_seconds": 960,
          "signal_oldest_seconds": 940,
          "before_rollout_seconds": 1110
        }
      ]
    },
    "facet": {
      "choose": [
        {
          "field": "service.version",
          "twin": "service.version",
          "noun": "version",
          "others": "host.name and url.path",
          "value": "${param.incident.new_version}",
          "alias": "v${param.incident.new_version}",
          "cause": "so the new release is causing them",
          "mixed": "Hosts and endpoints",
          "ok_versions": [
            "${param.incident.current_version}",
            "${param.incident.current_version}"
          ],
          "ok_hosts": [
            "${param.incident.service}-${param.nodes.0}",
            "${param.incident.service}-${param.nodes.1}",
            "${param.incident.service}-${param.nodes.2}",
            "${param.incident.service}-${param.nodes.3}"
          ],
          "ok_routes": [
            "${param.incident.route_a}",
            "${param.incident.route_b}",
            "${param.incident.route_c}"
          ]
        },
        {
          "field": "host.name",
          "twin": "service.node.name",
          "noun": "host",
          "others": "service.version and url.path",
          "value": "${param.incident.service}-${param.nodes.0}",
          "alias": "${param.incident.service}-${param.nodes.0}",
          "cause": "so that host is causing them",
          "mixed": "Versions and endpoints",
          "ok_versions": [
            "${param.incident.new_version}",
            "${param.incident.current_version}"
          ],
          "ok_hosts": [
            "${param.incident.service}-${param.nodes.1}",
            "${param.incident.service}-${param.nodes.2}",
            "${param.incident.service}-${param.nodes.3}",
            "${param.incident.service}-${param.nodes.4}"
          ],
          "ok_routes": [
            "${param.incident.route_a}",
            "${param.incident.route_b}",
            "${param.incident.route_c}"
          ]
        },
        {
          "field": "url.path",
          "twin": "url.path",
          "noun": "endpoint",
          "others": "service.version and host.name",
          "value": "${param.incident.route_a}",
          "alias": "${param.incident.route_a}",
          "cause": "so that endpoint is failing",
          "mixed": "Versions and hosts",
          "ok_versions": [
            "${param.incident.new_version}",
            "${param.incident.current_version}"
          ],
          "ok_hosts": [
            "${param.incident.service}-${param.nodes.0}",
            "${param.incident.service}-${param.nodes.1}",
            "${param.incident.service}-${param.nodes.2}",
            "${param.incident.service}-${param.nodes.3}"
          ],
          "ok_routes": [
            "${param.incident.route_b}",
            "${param.incident.route_c}",
            "${param.incident.route_b}"
          ]
        }
      ]
    }
  },
  "provisioning": {
    "strategies": [
      "seeded-events",
      "saved-objects"
    ],
    "seeded_events": {
      "signal_count": 35,
      "noise_count": 100,
      "noise_exclude_services": [
        "${param.incident.service}"
      ],
      "signal_window_seconds": [
        10,
        "${param.timing.signal_oldest_seconds}"
      ],
      "signal": {
        "service": {
          "name": "${param.incident.service}"
        },
        "event": {
          "outcome": "failure"
        },
        "http": {
          "response": {
            "status_code": "${param.incident.status}"
          }
        },
        "transaction": {
          "result": "HTTP 5xx"
        },
        "message": "${param.incident.service} request failed with HTTP ${param.incident.status}",
        "set": {
          "${param.facet.field}": "${param.facet.value}",
          "${param.facet.twin}": "${param.facet.value}"
        }
      },
      "distractors": [],
      "companions": [
        {
          "count": 38,
          "offset_seconds": 12,
          "interval_seconds": 26,
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}"
            },
            "event": {
              "outcome": "success"
            },
            "http": {
              "response": {
                "status_code": 200
              }
            },
            "message": "request completed"
          },
          "cycles": [
            [
              {
                "url": {
                  "path": "${param.facet.ok_routes.0}"
                }
              },
              {
                "url": {
                  "path": "${param.facet.ok_routes.1}"
                }
              },
              {
                "url": {
                  "path": "${param.facet.ok_routes.2}"
                }
              }
            ],
            [
              {
                "host": {
                  "name": "${param.facet.ok_hosts.0}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.0}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.facet.ok_hosts.1}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.1}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.facet.ok_hosts.2}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.2}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.facet.ok_hosts.3}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.3}"
                  }
                }
              }
            ],
            [
              {
                "service": {
                  "version": "${param.facet.ok_versions.0}"
                }
              },
              {
                "service": {
                  "version": "${param.facet.ok_versions.1}"
                }
              }
            ]
          ]
        },
        {
          "count": 5,
          "offset_seconds": "${param.timing.before_rollout_seconds}",
          "interval_seconds": 45,
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}",
              "version": "${param.incident.current_version}"
            },
            "event": {
              "outcome": "success"
            },
            "http": {
              "response": {
                "status_code": 200
              }
            },
            "message": "request completed"
          },
          "cycles": [
            [
              {
                "url": {
                  "path": "${param.facet.ok_routes.0}"
                }
              },
              {
                "url": {
                  "path": "${param.facet.ok_routes.1}"
                }
              },
              {
                "url": {
                  "path": "${param.facet.ok_routes.2}"
                }
              }
            ],
            [
              {
                "host": {
                  "name": "${param.facet.ok_hosts.0}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.0}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.facet.ok_hosts.1}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.1}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.facet.ok_hosts.2}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.2}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.facet.ok_hosts.3}"
                },
                "service": {
                  "node": {
                    "name": "${param.facet.ok_hosts.3}"
                  }
                }
              }
            ]
          ]
        },
        {
          "count": 1,
          "offset_seconds": "${param.timing.first_seconds}",
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}"
            },
            "event": {
              "outcome": "failure"
            },
            "http": {
              "response": {
                "status_code": "${param.incident.status}"
              }
            },
            "transaction": {
              "result": "HTTP 5xx"
            },
            "message": "${param.incident.service} request failed with HTTP ${param.incident.status}",
            "set": {
              "${param.facet.field}": "${param.facet.value}",
              "${param.facet.twin}": "${param.facet.value}"
            }
          },
          "cycles": [
            [
              {
                "url": {
                  "path": "${param.incident.route_a}"
                }
              },
              {
                "url": {
                  "path": "${param.incident.route_b}"
                }
              },
              {
                "url": {
                  "path": "${param.incident.route_c}"
                }
              }
            ],
            [
              {
                "host": {
                  "name": "${param.incident.service}-${param.nodes.0}"
                },
                "service": {
                  "node": {
                    "name": "${param.incident.service}-${param.nodes.0}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.incident.service}-${param.nodes.1}"
                },
                "service": {
                  "node": {
                    "name": "${param.incident.service}-${param.nodes.1}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.incident.service}-${param.nodes.2}"
                },
                "service": {
                  "node": {
                    "name": "${param.incident.service}-${param.nodes.2}"
                  }
                }
              },
              {
                "host": {
                  "name": "${param.incident.service}-${param.nodes.3}"
                },
                "service": {
                  "node": {
                    "name": "${param.incident.service}-${param.nodes.3}"
                  }
                }
              }
            ],
            [
              {
                "service": {
                  "version": "${param.incident.new_version}"
                }
              },
              {
                "service": {
                  "version": "${param.incident.current_version}"
                }
              }
            ]
          ]
        },
        {
          "count": 24,
          "offset_seconds": 20,
          "interval_seconds": 40,
          "trace": "own",
          "event": {
            "service": {
              "name": "${param.incident.service}",
              "version": "${param.incident.legacy_version}",
              "node": {
                "name": "${param.incident.service}-${param.nodes.4}"
              }
            },
            "host": {
              "name": "${param.incident.service}-${param.nodes.4}"
            },
            "event": {
              "outcome": "success"
            },
            "http": {
              "response": {
                "status_code": 200
              }
            },
            "message": "request completed"
          },
          "cycles": [
            [
              {
                "url": {
                  "path": "${param.facet.ok_routes.0}"
                }
              },
              {
                "url": {
                  "path": "${param.facet.ok_routes.1}"
                }
              },
              {
                "url": {
                  "path": "${param.facet.ok_routes.2}"
                }
              }
            ]
          ]
        }
      ],
      "signal_cycles": [
        [
          {
            "url": {
              "path": "${param.incident.route_a}"
            }
          },
          {
            "url": {
              "path": "${param.incident.route_b}"
            }
          },
          {
            "url": {
              "path": "${param.incident.route_c}"
            }
          }
        ],
        [
          {
            "host": {
              "name": "${param.incident.service}-${param.nodes.0}"
            },
            "service": {
              "node": {
                "name": "${param.incident.service}-${param.nodes.0}"
              }
            }
          },
          {
            "host": {
              "name": "${param.incident.service}-${param.nodes.1}"
            },
            "service": {
              "node": {
                "name": "${param.incident.service}-${param.nodes.1}"
              }
            }
          },
          {
            "host": {
              "name": "${param.incident.service}-${param.nodes.2}"
            },
            "service": {
              "node": {
                "name": "${param.incident.service}-${param.nodes.2}"
              }
            }
          },
          {
            "host": {
              "name": "${param.incident.service}-${param.nodes.3}"
            },
            "service": {
              "node": {
                "name": "${param.incident.service}-${param.nodes.3}"
              }
            }
          }
        ],
        [
          {
            "service": {
              "version": "${param.incident.new_version}"
            }
          },
          {
            "service": {
              "version": "${param.incident.current_version}"
            }
          }
        ]
      ]
    },
    "readiness_validators": [
      {
        "id": "seeded-signal",
        "kind": "es_count",
        "minimum": 20,
        "query": {
          "term": {
            "message.keyword": "${param.incident.service} request failed with HTTP ${param.incident.status}"
          }
        }
      }
    ]
  },
  "starting_view": {
    "app": "discover",
    "saved_object": "incident-investigation",
    "path": "/app/discover#/view/incident-investigation?_a=(columns:!('@timestamp',service.name,host.name,url.path,service.version,http.response.status_code))"
  },
  "truth": {
    "answers": {
      "finding": "${param.facet.field}: ${param.facet.value}",
      "scope": "${param.incident.service}",
      "conclusion": "In ${param.incident.service}, every failed request had ${param.facet.field} ${param.facet.value} and no successful one did, ${param.facet.cause}.",
      "first_seen": "${incident.first_clock}"
    },
    "accept": {
      "finding": [
        "${param.facet.value}",
        "${param.facet.alias}"
      ]
    },
    "assertions": [
      {
        "id": "signal",
        "kind": "es_count",
        "minimum": 20,
        "query": {
          "term": {
            "message.keyword": "${param.incident.service} request failed with HTTP ${param.incident.status}"
          }
        }
      },
      {
        "id": "corroboration",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "bool": {
            "filter": [
              {
                "term": {
                  "service.name.keyword": "${param.incident.service}"
                }
              },
              {
                "term": {
                  "http.response.status_code": 200
                }
              }
            ]
          }
        }
      },
      {
        "id": "first_appearance",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "bool": {
            "filter": [
              {
                "term": {
                  "${param.facet.field}.keyword": "${param.facet.value}"
                }
              },
              {
                "range": {
                  "@timestamp": {
                    "lte": "${incident.first_at}||+5s"
                  }
                }
              }
            ]
          }
        }
      },
      {
        "id": "healthy_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "term": {
            "event.outcome.keyword": "success"
          }
        }
      },
      {
        "id": "failures_in_view",
        "kind": "es_count",
        "maximum": 0,
        "query": {
          "term": {
            "event.outcome.keyword": "failure"
          }
        }
      }
    ]
  },
  "answer_schema": {
    "type": "diagnosis",
    "fields": [
      {
        "id": "finding",
        "label": "What the failed requests share",
        "kind": "string",
        "weight": 2,
        "placeholder": "A field and its value"
      },
      {
        "id": "scope",
        "label": "Service",
        "kind": "string",
        "weight": 1
      },
      {
        "id": "first_seen",
        "label": "First failure",
        "kind": "clock",
        "at": "first",
        "weight": 1,
        "placeholder": "The time Discover shows for it (HH:MM)"
      },
      {
        "id": "conclusion",
        "label": "Conclusion",
        "kind": "statement",
        "mentions": [
          "finding",
          "scope"
        ],
        "weight": 1
      },
      {
        "id": "evidence",
        "label": "Evidence",
        "kind": "text",
        "scored": false
      }
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {
    "delete_space": true,
    "delete_run_data": true,
    "managed_resources": []
  }
}
