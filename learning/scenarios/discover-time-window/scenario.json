{
  "schema_version": 2,
  "id": "discover-time-window",
  "version": 2,
  "title": "Find the checkout incident window",
  "type": "analysis",
  "classification": "core",
  "difficulty": 1,
  "estimated_minutes": 10,
  "brief": "Support reports a brief service problem. Establish whether the report aligns with observable activity and identify the relevant interval.",
  "skills": ["discover", "time-range", "histogram"],
  "required_capabilities": ["discover", "spaces", "saved_objects"],
  "parameters": {
    "incident": {
      "choose": [
        {"service": "checkout", "route": "/checkout", "status": 503, "status_family": "HTTP 503"},
        {"service": "orders", "route": "/api/orders", "status": 500, "status_family": "HTTP 5xx"},
        {"service": "payments", "route": "/api/payments/authorize", "status": 502, "status_family": "HTTP 502"},
        {"service": "catalog", "route": "/api/catalog/search", "status": 503, "status_family": "HTTP 503"}
      ]
    },
    "window": {
      "choose": [
        {"value": "10m", "label": "last 10 minutes"},
        {"value": "15m", "label": "last 15 minutes"},
        {"value": "30m", "label": "last 30 minutes"},
        {"value": "1h", "label": "last hour"}
      ]
    }
  },
  "provisioning": {
    "strategies": ["seeded-events", "saved-objects"],
    "seeded_events": {
      "signal_count": 28,
      "noise_count": 80,
      "signal": {
        "labels": {"signal": "decisive"},
        "service": {"name": "${param.incident.service}"},
        "event": {"outcome": "failure"},
        "http": {"response": {"status_code": "${param.incident.status}"}},
        "url": {"path": "${param.incident.route}"},
        "message": "${param.incident.service} temporarily unavailable"
      },
      "companions": [
        {
          "count": 2,
          "event": {
            "labels": {"corroboration": true},
            "service": {"name": "${param.incident.service}"},
            "event": {"outcome": "failure"},
            "url": {"path": "${param.incident.route}"},
            "message": "support-reported ${param.incident.service} interval confirmed"
          }
        }
      ]
    },
    "readiness_validators": [
      {"id": "seeded-signal", "kind": "es_count", "minimum": 20, "query": {"term": {"labels.signal.keyword": "decisive"}}}
    ]
  },
  "starting_view": {"app": "discover", "saved_object": "incident-investigation", "path": "/app/discover#/view/incident-investigation"},
  "truth": {
    "answers": {
      "finding": "${param.window.label}",
      "scope": "${param.incident.service} traffic",
      "conclusion": "The ${param.incident.service} error surge aligns with the reported ${param.window.label} interval."
    },
    "assertions": [
      {"id": "signal", "kind": "es_count", "minimum": 20, "query": {"term": {"labels.signal.keyword": "decisive"}}},
      {"id": "corroboration", "kind": "es_count", "minimum": 1, "query": {"term": {"labels.corroboration": true}}}
    ]
  },
  "answer_schema": {
    "type": "comparison",
    "fields": [
      {"id": "finding", "label": "Incident window", "kind": "string", "weight": 2},
      {"id": "scope", "label": "Observed scope", "kind": "string", "weight": 1},
      {"id": "conclusion", "label": "Conclusion", "kind": "string", "weight": 1},
      {"id": "evidence_refs", "label": "Evidence references", "kind": "string", "scored": false},
      {"id": "evidence", "label": "Evidence explanation", "kind": "text", "scored": false}
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {"delete_space": true, "delete_run_data": true, "managed_resources": []}
}
