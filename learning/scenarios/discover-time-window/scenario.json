{
  "schema_version": 2,
  "id": "discover-time-window",
  "version": 4,
  "title": "Find the incident window",
  "type": "analysis",
  "classification": "core",
  "difficulty": 1,
  "estimated_minutes": 10,
  "brief": "Support says something went wrong for a short time. Check whether the data backs up their report, and find the time window when it happened.",
  "skills": ["discover", "time-range", "histogram"],
  "required_capabilities": ["discover", "spaces", "saved_objects"],
  "parameters": {
    "incident": {
      "choose": [
        {"service": "checkout", "route": "/checkout", "status": 503, "status_family": "HTTP 503", "journey": "checkout", "headline": "Checkout failing on and off for some users"},
        {"service": "orders", "route": "/api/orders", "status": 500, "status_family": "HTTP 5xx", "journey": "order", "headline": "Orders failing on and off for some users"},
        {"service": "payments", "route": "/api/payments/authorize", "status": 502, "status_family": "HTTP 502", "journey": "card payment", "headline": "Card payments failing on and off for some users"},
        {"service": "catalog", "route": "/api/catalog/search", "status": 503, "status_family": "HTTP 503", "journey": "product search", "headline": "Product search failing on and off for some users"}
      ]
    },
    "timing": {
      "choose": [
        {"noticed": 8, "onset": 11, "end": 5, "noticed_seconds": 480, "onset_seconds": 660, "end_seconds": 300},
        {"noticed": 10, "onset": 12, "end": 6, "noticed_seconds": 600, "onset_seconds": 720, "end_seconds": 360},
        {"noticed": 7, "onset": 10, "end": 4, "noticed_seconds": 420, "onset_seconds": 600, "end_seconds": 240}
      ]
    },
    "window": {
      "choose": [
        {"value": "15m", "label": "last 15 minutes"}
      ]
    }
  },
  "provisioning": {
    "strategies": ["seeded-events", "saved-objects"],
    "seeded_events": {
      "signal_count": 28,
      "noise_count": 80,
      "signal_window_seconds": ["${param.timing.end_seconds}", "${param.timing.onset_seconds}"],
      "signal": {
        "service": {"name": "${param.incident.service}"},
        "event": {"outcome": "failure"},
        "http": {"response": {"status_code": "${param.incident.status}"}},
        "url": {"path": "${param.incident.route}"},
        "message": "${param.incident.service} temporarily unavailable"
      },
      "companions": [
        {
          "count": 2,
          "offset_seconds": "${param.timing.noticed_seconds}",
          "event": {
            "service": {"name": "${param.incident.service}"},
            "event": {"outcome": "failure"},
            "http": {"response": {"status_code": "${param.incident.status}"}},
            "url": {"path": "${param.incident.route}"},
            "message": "support-reported ${param.incident.service} interval confirmed"
          }
        }
      ]
    },
    "readiness_validators": [
      {"id": "seeded-signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "${param.incident.service} temporarily unavailable"}}}
    ]
  },
  "starting_view": {"app": "discover", "saved_object": "incident-investigation", "path": "/app/discover#/view/incident-investigation?_g=(time:(from:now-1h,to:now))"},
  "truth": {
    "answers": {
      "finding": "${param.window.label}",
      "scope": "${param.incident.service} traffic",
      "conclusion": "Errors from ${param.incident.service} spiked during the ${param.window.label}.",
      "status": "${param.incident.status}",
      "route": "${param.incident.route}"
    },
    "accept": {"scope": ["${param.incident.service}"]},
    "assertions": [
      {"id": "signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "${param.incident.service} temporarily unavailable"}}},
      {"id": "corroboration", "kind": "es_count", "minimum": 1, "query": {"term": {"message.keyword": "support-reported ${param.incident.service} interval confirmed"}}}
    ]
  },
  "answer_schema": {
    "type": "comparison",
    "fields": [
      {"id": "finding", "label": "Incident window", "kind": "window", "weight": 2, "placeholder": "When it started and stopped, e.g. 14:05–14:12"},
      {"id": "status", "label": "Failing status code", "kind": "string", "weight": 1},
      {"id": "route", "label": "Affected endpoint", "kind": "string", "weight": 1},
      {"id": "scope", "label": "Affected service", "kind": "string", "weight": 1},
      {"id": "conclusion", "label": "Conclusion", "kind": "statement", "mentions": ["scope", "finding"], "weight": 1, "placeholder": "What failed, and when"},
      {"id": "evidence", "label": "Evidence explanation", "kind": "text", "scored": false}
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {"delete_space": true, "delete_run_data": true, "managed_resources": []}
}
