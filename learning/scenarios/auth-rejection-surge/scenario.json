{
  "schema_version": 2,
  "id": "auth-rejection-surge",
  "version": 4,
  "title": "An increase in rejected sign-ins",
  "type": "investigation",
  "classification": "core",
  "difficulty": 1,
  "estimated_minutes": 16,
  "brief": "More sign-ins are being rejected than usual, but some rejections happen every day. Find the reason behind the increase and the client it affects.",
  "skills": ["boolean-kql", "include-exclude", "top-values"],
  "required_capabilities": ["discover", "spaces", "saved_objects"],
  "parameters": {
    "incident": {
      "merge": [
        {
          "choose": [
            {"reason": "device_untrusted", "message": "sign-in rejected: device not trusted", "detail": "blocked a sign-in from an untrusted device"},
            {"reason": "mfa_timeout", "message": "sign-in rejected: MFA challenge timed out", "detail": "let an MFA challenge time out"},
            {"reason": "expired_nonce", "message": "sign-in rejected: expired nonce", "detail": "sent an expired nonce"},
            {"reason": "token_reuse", "message": "sign-in rejected: replayed refresh token", "detail": "replayed a refresh token"},
            {"reason": "region_blocked", "message": "sign-in rejected: region not allowed", "detail": "signed in from a blocked region"},
            {"reason": "captcha_failed", "message": "sign-in rejected: captcha check failed", "detail": "failed a captcha check"}
          ]
        },
        {
          "choose": [
            {"client": "desktop-app"}, {"client": "ios-app"}, {"client": "android-app"}, {"client": "mobile-web"},
            {"client": "partner-api"}, {"client": "smart-tv-app"}, {"client": "kiosk-app"}
          ]
        }
      ]
    },
    "everyday": {"sample": ["bad_password", "session_expired", "account_locked", "rate_limited"], "count": 2},
    "timing": {
      "choose": [
        {"onset": 10, "onset_seconds": 600, "noticed": 6, "baseline": 25},
        {"onset": 12, "onset_seconds": 720, "noticed": 7, "baseline": 27},
        {"onset": 14, "onset_seconds": 840, "noticed": 9, "baseline": 29}
      ]
    }
  },
  "provisioning": {
    "strategies": ["seeded-events", "saved-objects"],
    "seeded_events": {
      "signal_count": 50,
      "noise_count": 90,
      "signal_window_seconds": [10, "${param.timing.onset_seconds}"],
      "signal": {
        "service": {"name": "auth"},
        "event": {"outcome": "failure"},
        "http": {"response": {"status_code": 401}},
        "client": {"application": {"name": "${param.incident.client}"}},
        "authentication": {"rejection_reason": "${param.incident.reason}"},
        "message": "${param.incident.message}"
      },
      "companions": [
        {
          "count": 2,
          "event": {
            "service": {"name": "auth"},
            "event": {"outcome": "failure"},
            "http": {"response": {"status_code": 401}},
            "client": {"application": {"name": "${param.incident.client}"}},
            "authentication": {"rejection_reason": "${param.incident.reason}"},
            "message": "${param.incident.client} ${param.incident.detail}"
          }
        },
        {
          "count": 25,
          "offset_seconds": 20,
          "interval_seconds": 90,
          "jitter_seconds": 40,
          "trace": "own",
          "event": {
            "service": {"name": "auth"},
            "event": {"outcome": "failure"},
            "http": {"response": {"status_code": 401}},
            "authentication": {"rejection_reason": "${param.everyday.0}"},
            "message": "sign-in rejected: ${param.everyday.0}"
          },
          "cycle": [
            {"client": {"application": {"name": "public-web"}}},
            {"client": {"application": {"name": "mobile-web"}}},
            {"client": {"application": {"name": "ios-app"}}},
            {"client": {"application": {"name": "android-app"}}},
            {"client": {"application": {"name": "desktop-app"}}}
          ]
        },
        {
          "count": 25,
          "offset_seconds": 65,
          "interval_seconds": 90,
          "jitter_seconds": 40,
          "trace": "own",
          "event": {
            "service": {"name": "auth"},
            "event": {"outcome": "failure"},
            "http": {"response": {"status_code": 401}},
            "authentication": {"rejection_reason": "${param.everyday.1}"},
            "message": "sign-in rejected: ${param.everyday.1}"
          },
          "cycle": [
            {"client": {"application": {"name": "android-app"}}},
            {"client": {"application": {"name": "public-web"}}},
            {"client": {"application": {"name": "desktop-app"}}},
            {"client": {"application": {"name": "mobile-web"}}},
            {"client": {"application": {"name": "ios-app"}}}
          ]
        }
      ]
    },
    "readiness_validators": [
      {"id": "seeded-signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "${param.incident.message}"}}}
    ]
  },
  "starting_view": {"app": "discover", "saved_object": "incident-investigation", "path": "/app/discover#/view/incident-investigation"},
  "truth": {
    "answers": {
      "finding": "${param.incident.reason}",
      "scope": "${param.incident.client}",
      "conclusion": "The unusual ${param.incident.reason} rejections all come from the ${param.incident.client} client."
    },
    "assertions": [
      {"id": "signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "${param.incident.message}"}}},
      {"id": "corroboration", "kind": "es_count", "minimum": 1, "query": {"term": {"message.keyword": "${param.incident.client} ${param.incident.detail}"}}},
      {"id": "healthy_in_view", "kind": "es_count", "maximum": 0, "query": {"term": {"event.outcome.keyword": "success"}}}
    ]
  },
  "answer_schema": {
    "type": "diagnosis",
    "fields": [
      {"id": "finding", "label": "Rejection reason", "kind": "string", "weight": 2},
      {"id": "scope", "label": "Affected client", "kind": "string", "weight": 1},
      {"id": "conclusion", "label": "Conclusion", "kind": "statement", "mentions": ["finding", "scope"], "weight": 1},
      {"id": "evidence", "label": "Evidence", "kind": "text", "scored": false}
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {"delete_space": true, "delete_run_data": true, "managed_resources": []}
}
