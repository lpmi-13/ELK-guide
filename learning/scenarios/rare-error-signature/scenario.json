{
  "schema_version": 2,
  "id": "rare-error-signature",
  "version": 4,
  "title": "A rare error in a busy service",
  "type": "investigation",
  "classification": "core",
  "difficulty": 2,
  "estimated_minutes": 18,
  "brief": "A busy service logs one rare exception that seems linked to failed requests. Find the exception and one request where it happened.",
  "skills": [
    "field-statistics",
    "cardinality",
    "surrounding-documents"
  ],
  "required_capabilities": [
    "discover",
    "spaces",
    "saved_objects"
  ],
  "parameters": {
    "incident": {
      "choose": [
        {
          "service": "catalog",
          "error_type": "InventoryReservationRace",
          "route_path": "/items/reserve",
          "message": "inventory reservation raced with stock update",
          "noise_message": "catalog cache refresh delayed",
          "precursor": "stock update committed while a reservation was still open"
        },
        {
          "service": "orders",
          "error_type": "OrderIdempotencyConflict",
          "route_path": "/api/orders",
          "message": "duplicate order submission detected",
          "noise_message": "orders retry budget replenished",
          "precursor": "client resubmitted the order after a gateway timeout"
        },
        {
          "service": "payments",
          "error_type": "LedgerRoundingError",
          "route_path": "/api/payments/settle",
          "message": "settlement rounding mismatch detected",
          "noise_message": "payments settlement batch queued",
          "precursor": "settlement converted currency at 3 decimal places"
        },
        {
          "service": "auth",
          "error_type": "SessionReplayDetected",
          "route_path": "/api/auth/refresh",
          "message": "refused a replayed session token",
          "noise_message": "auth key rotation completed",
          "precursor": "refresh token presented again from a second device"
        },
        {
          "service": "checkout",
          "error_type": "CartLockTimeout",
          "route_path": "/checkout/cart",
          "message": "cart lock held past its timeout",
          "noise_message": "checkout session cache trimmed",
          "precursor": "two tabs updated the same cart within one second"
        },
        {
          "service": "orders",
          "error_type": "ShipmentAddressMismatch",
          "route_path": "/api/orders/ship",
          "message": "shipment address did not match the order",
          "noise_message": "orders shipping estimate refreshed",
          "precursor": "address book update arrived after the order was placed"
        },
        {
          "service": "payments",
          "error_type": "RefundCurrencyMismatch",
          "route_path": "/api/payments/refund",
          "message": "refund currency did not match the original charge",
          "noise_message": "payments exchange rates refreshed",
          "precursor": "refund requested in the store's display currency"
        },
        {
          "service": "catalog",
          "error_type": "PriceVersionConflict",
          "route_path": "/api/catalog/items",
          "message": "price version conflict on item update",
          "noise_message": "catalog search index compacted",
          "precursor": "two price imports touched the same item"
        }
      ]
    }
  },
  "provisioning": {
    "strategies": [
      "seeded-events",
      "saved-objects"
    ],
    "seeded_events": {
      "signal_count": 12,
      "noise_count": 180,
      "signal": {
        "service": {
          "name": "${param.incident.service}"
        },
        "event": {
          "outcome": "failure"
        },
        "error": {
          "type": "${param.incident.error_type}"
        },
        "message": "${param.incident.message}"
      },
      "distractors": [
        {
          "log": {
            "level": "WARN"
          },
          "message": "${param.incident.noise_message}"
        }
      ],
      "companions": [
        {
          "count": 3,
          "event": {
            "service": {
              "name": "${param.incident.service}"
            },
            "event": {
              "outcome": "failure"
            },
            "error": {
              "type": "${param.incident.error_type}"
            },
            "url": {
              "path": "${param.incident.route_path}"
            },
            "message": "request failed after ${param.incident.error_type}"
          },
          "offset_seconds": 250
        },
        {
          "trace": "each",
          "offset_ms": -180,
          "event": {
            "service": {
              "name": "${param.incident.service}"
            },
            "log": {
              "level": "INFO"
            },
            "message": "${param.incident.precursor}"
          }
        }
      ]
    },
    "readiness_validators": [
      {
        "id": "seeded-signal",
        "kind": "es_count",
        "minimum": 10,
        "query": {
          "term": {
            "message.keyword": "${param.incident.message}"
          }
        }
      }
    ]
  },
  "starting_view": {
    "app": "discover",
    "saved_object": "incident-investigation",
    "path": "/app/discover#/view/incident-investigation"
  },
  "truth": {
    "answers": {
      "finding": "${param.incident.error_type}",
      "scope": "${param.incident.service}",
      "conclusion": "The rare ${param.incident.error_type} exception is linked to failed ${param.incident.service} requests."
    },
    "assertions": [
      {
        "id": "signal",
        "kind": "es_count",
        "minimum": 10,
        "query": {
          "term": {
            "message.keyword": "${param.incident.message}"
          }
        }
      },
      {
        "id": "corroboration",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "term": {
            "message.keyword": "request failed after ${param.incident.error_type}"
          }
        }
      },
      {
        "id": "precursor",
        "kind": "es_count",
        "minimum": 1,
        "query": {
          "term": {
            "message.keyword": "${param.incident.precursor}"
          }
        }
      }
    ]
  },
  "answer_schema": {
    "type": "diagnosis",
    "fields": [
      {
        "id": "finding",
        "label": "Rare error type",
        "kind": "string",
        "weight": 2
      },
      {
        "id": "scope",
        "label": "Service",
        "kind": "string",
        "weight": 1
      },
      {
        "id": "conclusion",
        "label": "Conclusion",
        "kind": "statement",
        "mentions": [
          "finding",
          "scope"
        ],
        "weight": 1
      },
      {
        "id": "evidence",
        "label": "Example request",
        "kind": "text",
        "scored": false
      }
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {
    "delete_space": true,
    "delete_run_data": true,
    "managed_resources": []
  }
}
