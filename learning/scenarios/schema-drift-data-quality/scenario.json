{
  "schema_version": 2,
  "id": "schema-drift-data-quality",
  "version": 2,
  "title": "Fewer requests than normal on a dashboard",
  "type": "analysis",
  "classification": "core",
  "difficulty": 2,
  "estimated_minutes": 15,
  "brief": "A dashboard only counts requests that have a value in http.route. That count dropped, but total traffic stayed the same. Find the producer and version that stopped sending http.route.",
  "skills": ["missing-fields", "field-statistics", "producer-comparison"],
  "required_capabilities": ["discover", "spaces", "saved_objects"],
  "parameters": {
    "incident": {
      "choose": [
        {"service": "checkout", "producer": "telemetry-java/3.2", "good_producer": "telemetry-java/3.1", "version": "4.8.0", "route": "/checkout"},
        {"service": "orders", "producer": "telemetry-go/2.5", "good_producer": "telemetry-go/2.4", "version": "5.1.0", "route": "/api/orders"},
        {"service": "payments", "producer": "telemetry-node/1.9", "good_producer": "telemetry-node/1.8", "version": "2.3.0", "route": "/api/payments"},
        {"service": "catalog", "producer": "telemetry-python/4.0", "good_producer": "telemetry-python/3.9", "version": "6.0.0", "route": "/api/catalog"}
      ]
    }
  },
  "provisioning": {
    "strategies": ["seeded-events", "saved-objects"],
    "seeded_events": {
      "signal_count": 34,
      "noise_count": 90,
      "signal": {
        "service": {"name": "${param.incident.service}", "version": "${param.incident.version}"},
        "telemetry": {"producer": "${param.incident.producer}"},
        "schema": {"route_present": false},
        "message": "request recorded without expected route field"
      },
      "distractors": [
        {"telemetry": {"producer": "${param.incident.good_producer}"}, "schema": {"route_present": true}, "http": {"route": "${param.incident.route}"}}
      ],
      "companions": [
        {
          "count": 3,
          "event": {
            "service": {"name": "${param.incident.service}", "version": "${param.incident.version}"},
            "telemetry": {"producer": "${param.incident.producer}"},
            "schema": {"route_present": false},
            "message": "traffic volume unchanged despite missing route"
          }
        }
      ]
    },
    "readiness_validators": [
      {"id": "seeded-signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "request recorded without expected route field"}}}
    ]
  },
  "starting_view": {"app": "discover", "saved_object": "incident-investigation", "path": "/app/discover#/view/incident-investigation"},
  "truth": {
    "answers": {
      "finding": "${param.incident.producer}",
      "scope": "service.version ${param.incident.version}",
      "conclusion": "The ${param.incident.producer} producer on version ${param.incident.version} stopped sending http.route. The number of requests did not fall."
    },
    "accept": {"scope": ["${param.incident.version}"]},
    "assertions": [
      {"id": "signal", "kind": "es_count", "minimum": 20, "query": {"term": {"message.keyword": "request recorded without expected route field"}}},
      {"id": "corroboration", "kind": "es_count", "minimum": 1, "query": {"term": {"message.keyword": "traffic volume unchanged despite missing route"}}}
    ]
  },
  "answer_schema": {
    "type": "comparison",
    "fields": [
      {"id": "finding", "label": "Producer", "kind": "string", "weight": 2},
      {"id": "scope", "label": "Affected version", "kind": "string", "weight": 1},
      {"id": "conclusion", "label": "Conclusion", "kind": "statement", "mentions": ["finding", "scope"], "weight": 1},
      {"id": "evidence", "label": "Evidence", "kind": "text", "scored": false}
    ]
  },
  "playbook": "playbook.json",
  "rubric": "rubric.json",
  "cleanup": {"delete_space": true, "delete_run_data": true, "managed_resources": []}
}
